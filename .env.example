# MAPE.LEGAL — Variables de entorno requeridas
# Copiar este archivo a .env.local y completar los valores antes de ejecutar la app.
# NUNCA commitear .env.local — está en .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Enable the "Continuar con Google" button on /login. Set to "true" to show it.
# The Client ID/Secret are configured in Supabase Dashboard → Auth → Providers,
# never in this file.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mape.legal

# ─── Email — SendGrid ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=gerencia@mape.legal
SENDGRID_FROM_NAME=MAPE.LEGAL

# ─── WhatsApp — Meta Cloud API ───────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — valida X-Hub-Signature-256 en /api/webhook/whatsapp.
# OBLIGATORIA: sin esta key el webhook responde error y NO procesa el cuerpo.
WHATSAPP_APP_SECRET=

# ─── WhatsApp — Twilio (asistente María) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Firma X-Twilio-Signature en /api/whatsapp. Default (unset): ENFORCE — una
# firma que no calza se rechaza con 403. Interruptores de emergencia, solo
# para un rollback consciente (no son el default):
#   TWILIO_VALIDATE_SIGNATURE=false  → salta la validación por completo
#   TWILIO_SIGNATURE_LOG_ONLY=true   → valida y loguea, pero deja pasar
# Sin TWILIO_AUTH_TOKEN el webhook rechaza con 500 (no se puede validar).
TWILIO_VALIDATE_SIGNATURE=
TWILIO_SIGNATURE_LOG_ONLY=

# ─── María — modo ejecutivo por WhatsApp ─────────────────────────────────────
# Passphrase del reporte ejecutivo (antes hardcodeada en el repo — rotar).
# Sin esta var el modo ejecutivo queda DESACTIVADO (fail-closed). La passphrase
# sola nunca basta: el número emisor debe tener rol admin en usuarios_broadcast.
MARIA_ADMIN_PASSPHRASE=

# ─── María — web widget ──────────────────────────────────────────────────────
# Secreto HMAC para firmar los turnos assistant del widget (PR #167).
# Fallback si falta: SUPABASE_SERVICE_ROLE_KEY.
MARIA_WIDGET_SECRET=

# ─── Seed del super admin (scripts/seed-super-admin.mjs) ─────────────────────
# Solo para correr el seed manualmente — no las necesita la app en runtime.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── IA — Anthropic (asistente María) ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── IA — OpenAI (embeddings para RAG semántico de María) ────────────────────
# Modelo: text-embedding-3-small (1536 dims). Sin esta key, retrieveKnowledge()
# cae automáticamente al RPC FTS (search_maria_knowledge_fts) — el flow sigue
# funcionando, sólo se degrada el recall semántico.
OPENAI_API_KEY=

# ─── Broadcast diario de precios ─────────────────────────────────────────────
# Header Bearer para proteger GET/POST /api/broadcast/run. OBLIGATORIO en
# todos los entornos: sin él la ruta responde 500 y nunca dispara el boletín.
CRON_SECRET=
# goldapi.io — precios oro/plata/cobre (free tier disponible).
GOLDAPI_KEY=
# exchangerate-api.com v6 (opcional; sin clave usa tier gratuito).
EXCHANGE_RATE_API_KEY=

# ─── Mapa topográfico (Biblioteca Archivos Mineros) ──────────────────────────
# El mapa usa `maplibre-contour` con tiles DEM Terrarium públicos de AWS Open
# Data (sin auth). Atribución obligatoria "Tile data © Mapzen" ya incluida
# en el AttributionControl del componente. No requiere ninguna env var.

# ─── OCR — Mistral (Mercado de Proyectos / biblioteca de documentos) ─────────
# Usado por services/marketplace/processing.ts para extraer texto de PDFs vía
# la API de Mistral OCR (modelo mistral-ocr-latest). Sin esta key, la subida de
# documentos funciona pero el procesamiento OCR falla (ocr_status='failed').
MISTRAL_API_KEY=

